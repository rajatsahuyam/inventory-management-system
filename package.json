{
  "name": "InventoryManagementSystem",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.6",
    "eslint": "9.39.4",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "undeploy": "cf undeploy InventoryManagementSystem --delete-services --delete-service-keys --delete-service-brokers",
    "watch-inventorymanagementsystem": "cds watch --open inventorymanagementsystem/index.html?sap-ui-xx-viewCache=false --livereload false",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "mbt build && cf deploy mta_archives/InventoryManagementSystem_1.0.0.mtar"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "launchpad": {
        "kind": "launchpad"
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/inventorymanagementsystem"
  ]
}